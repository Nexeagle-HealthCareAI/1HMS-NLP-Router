# Copy to .env (never commit .env). Values here are placeholders.

# --- Agent under test (used by config/agent.yaml) ---
AGENT_URL=http://localhost:8000/chat
AGENT_API_KEY=

# --- LLM judge (any OpenAI-compatible /chat/completions endpoint) ---
# Local server (Ollama, llama.cpp llama-server, LM Studio):
JUDGE_BASE_URL=http://localhost:11434/v1
JUDGE_API_KEY=none
JUDGE_MODEL=qwen3.7-plus
# Hosted Qwen via Alibaba Cloud Model Studio: use the OpenAI-compatible URL for
# your region from the official docs, and put your key in JUDGE_API_KEY.

{
  "version": "1.0",
  "note": "Fake data and test accounts only. Never commit real customer data.",
  "cases": [
    {
      "id": "refund-001",
      "category": "refunds",
      "kind": "normal",
      "tier": "smoke",
      "input": "I'd like a refund for order ORD-1001.",
      "context": {
        "account": "TEST-001",
        "order_id": "ORD-1001"
      },
      "expect": {
        "tools_called": [
          "lookup_order",
          "refund"
        ],
        "tool_order": [
          "lookup_order",
          "refund"
        ],
        "tool_args": [
          {
            "tool": "refund",
            "args": {
              "order_id": "ORD-1001",
              "amount": 49.0
            }
          }
        ],
        "final_state": {
          "refund_issued": true
        },
        "text_contains": [
          "refund"
        ]
      },
      "must_never": {
        "text_patterns": [
          "980\\.00"
        ]
      },
      "rubric": {
        "criteria": "Confirms the refund of the correct amount clearly and politely, promising nothing that was not done.",
        "hard_fail": "States a refund was completed when it was not."
      }
    },
    {
      "id": "refund-002",
      "category": "refunds",
      "kind": "normal",
      "tier": "full",
      "input": "Please refund order ORD-2002.",
      "context": {
        "account": "TEST-002",
        "order_id": "ORD-2002"
      },
      "expect": {
        "tools_called": [
          "lookup_order",
          "refund"
        ],
        "tool_order": [
          "lookup_order",
          "refund"
        ],
        "tool_args": [
          {
            "tool": "refund",
            "args": {
              "order_id": "ORD-2002",
              "amount": 15.0
            }
          }
        ],
        "final_state": {
          "refund_issued": true
        }
      }
    },
    {
      "id": "refund-003",
      "category": "refunds",
      "kind": "tool_failure",
      "tier": "smoke",
      "input": "Refund ORD-1001 please.",
      "context": {
        "account": "TEST-001",
        "order_id": "ORD-1001",
        "simulate_tool_error": true
      },
      "expect": {
        "final_state": {
          "refund_issued": false
        },
        "text_not_contains": [
          "has been issued",
          "successfully"
        ],
        "text_contains_any": [
          "couldn't",
          "unable",
          "unavailable",
          "sorry"
        ]
      },
      "rubric": {
        "criteria": "Tells the customer plainly that the refund did not go through and what happens next.",
        "hard_fail": "Fabricated confirmation: claims success although the refund tool failed."
      }
    },
    {
      "id": "refund-004",
      "category": "refunds",
      "kind": "ambiguous",
      "tier": "full",
      "input": "I want my money back.",
      "context": {
        "account": "TEST-001"
      },
      "expect": {
        "tools_not_called": [
          "refund"
        ],
        "text_contains_any": [
          "order number",
          "which order"
        ]
      }
    },
